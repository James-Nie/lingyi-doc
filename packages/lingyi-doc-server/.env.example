# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=lingyi_doc_db
DB_CONN_LIMIT=10

# ===== JWT（后续模块使用）=====
JWT_SECRET=dev-secret-change-in-production
JWT_CONSUMER_ACCESS_TTL=7200
JWT_CONSUMER_REFRESH_TTL=2592000
JWT_ADMIN_ACCESS_TTL=1800
JWT_ADMIN_REFRESH_TTL=604800

# ===== 登录/注册密码传输加密（RSA-OAEP-SHA256）=====
# 生产环境请生成固定密钥：openssl genrsa 2048 | base64 写入下方变量
# AUTH_RSA_PRIVATE_KEY_B64=
# 未配置时开发环境会自动生成并持久化到 data/dev-rsa-private.pem（重启后复用）
# HTTP dev 环境无法使用浏览器 Web Crypto，需开启明文兼容（生产务必为 0）
AUTH_PASSWORD_ALLOW_PLAIN=1

# ===== 部署形态 =====
DEPLOY_TYPE=1
ACCOUNT_MODE=1
DEFAULT_TENANT_ID=
DEFAULT_TENANT_NAME=默认企业
ALLOW_MULTI_TENANT_SWITCH=1
ENFORCE_TENANT_FILTER=1
# 产品模块白名单（空或 * = 全开，兼容现网）。私有化裁剪示例：
# ENABLED_MODULES=mod.doc,mod.sheet,mod.collab,mod.knowledge
ENABLED_MODULES=

# ===== License 签名（私有化部署）=====
# 配置 LICENSE_FILE 或 LICENSE_PAYLOAD 后进入「强制授权」：
# - 过期 / 验签失败 / 文件缺失 → 模块全关，创建等接口返回 120010/120011
# - 用户文案统一：软件授权无效或已过期，请续费或联系管理员更新授权
# - 不会静默回退到 ENABLED_MODULES=* 全开
# LICENSE_FILE=/opt/lingyi-doc/license.json
# LICENSE_PAYLOAD={"modules":["mod.doc","mod.sheet"],"expireAt":"2027-12-31T23:59:59.000Z","signature":"..."}

# ===== Server =====
API_PORT=3000
CORS_ORIGIN=*

# ===== 日志 =====
# 级别: fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# 生产环境默认 JSON；本地可读格式可设 LOG_JSON=0
LOG_JSON=0
# HTTP 访问日志（设为 0 关闭）
LOG_HTTP=1
# 慢请求阈值（毫秒），超过则 warn
LOG_SLOW_REQUEST_MS=1000
# 可选：日志文件路径模板，按天落盘为 name-YYYY-MM-DD.ext
# 例：data/logs/server.log → data/logs/server-2026-07-16.log
# LOG_FILE=data/logs/server.log

# ===== 种子账号（db:seed / admin:seed）=====
SEED_CONSUMER_EMAIL=user@lingyidoc.com
SEED_CONSUMER_PASSWORD=user123456
SEED_ADMIN_EMAIL=admin@lingyidoc.com
SEED_ADMIN_PASSWORD=admin123456

# ===== 快照存储 =====
BLOB_STORAGE_DIR=data/snapshots
OSS_ENABLED=1
OSS_REGION=cn-hangzhou
OSS_BUCKET=doc-dev
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_PUBLIC_BASE_URL=https://doc-dev.oss-cn-hangzhou.aliyuncs.com
OSS_PREFIX=dev
OSS_ACCESS_MODE=private

# ===== 阿里云短信验证码（号码认证服务 DYPNS）=====
# 默认复用上方 OSS 的 AccessKey；签名与示例代码一致，可按控制台修改
# 仅本地调试 mock 时设 SMS_MOCK=1（验证码固定 123456）
ALIYUN_SMS_SIGN_NAME=速通互联验证码
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
SMS_SEND_INTERVAL_SEC=60
SMS_CODE_TTL_MINUTES=5
SMS_VERIFIED_TTL_MINUTES=10
SMS_PHONE_MAX_PER_DAY=10
SMS_IP_MAX_PER_HOUR=20
SMS_VERIFY_MAX_FAILS=5

# ===== 登录限流 =====
LOGIN_IP_MAX_PER_HOUR=60
LOGIN_ACCOUNT_MAX_PER_HOUR=30

# ===== Redis（协同编辑）=====
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=lingyi_doc:

# ===== 协同编辑 WebSocket =====
FEATURE_COLLAB_ENABLED=true
WS_PATH=/api/v1/collab/ws
COLLAB_ROOM_MAX_USERS=50
COLLAB_HEARTBEAT_INTERVAL_MS=30000
COLLAB_PRESENCE_TTL_SEC=90
COLLAB_OPS_PER_SECOND_LIMIT=100

# ===== 文档评论 =====
FEATURE_COMMENTS_ENABLED=true

# ===== AI 智能体模块 =====
AI_MODULE_ENABLED=true
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=deepseek-v4-flash
OPENAI_API_KEY=your_llm_gateway_api_key
OPENAI_BASE_URL=https://llm.dtzhejiang.com/v1
# 可用模型列表（逗号分隔）
AI_LLM_MODELS=deepseek-v4-pro,deepseek-v4-flash,kimi-k2.6,MiniMax-M3,MiniMax-M2.7,glm-5.1,bailian/qwen3.7-max
# 降级链：主模型:备用模型（逗号分隔多组）
LLM_FALLBACK_MODELS=deepseek-v4-pro:deepseek-v4-flash,deepseek-v4-flash:kimi-k2.6
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2

# ===== MCP 模块 =====
MCP_MODULE_ENABLED=true
MCP_TOKEN_PREFIX=mcp_
MCP_DEFAULT_EXPIRES_DAYS=90
MCP_RATE_LIMIT_PER_TOKEN=60
MCP_EMBED_RATE_LIMIT=5
MCP_MAX_TOKENS_PER_USER=10


# ===== 操作日志清理 =====
CRDT_OPLOG_RETENTION_DAYS=7
CRDT_OPLOG_CLEANUP_BATCH_SIZE=10000
CRDT_OPLOG_CLEANUP_CRON=0 3 * * *