{
  "name": "@lingyi-doc/server",
  "version": "0.1.0",
  "private": true,
  "description": "零一文档 服务端（NestJS + TypeORM）",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "predev": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "prestart": "npm run build",
    "prestart:prod": "npm run build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:create": "node dist/db-cli/createDatabase.js",
    "db:check": "node dist/db-cli/checkConnection.js",
    "db:init": "node dist/db-cli/init.js",
    "db:migrate": "node dist/db-cli/migrate.js",
    "db:seed": "node dist/db-cli/seed.js",
    "admin:seed": "node dist/db-cli/adminSeed.js",
    "db:create:dev": "tsx src/db-cli/createDatabase.ts",
    "db:check:dev": "tsx src/db-cli/checkConnection.ts",
    "db:init:dev": "tsx src/db-cli/init.ts",
    "db:migrate:dev": "tsx src/db-cli/migrate.ts",
    "db:seed:dev": "tsx src/db-cli/seed.ts",
    "admin:seed:dev": "tsx src/db-cli/adminSeed.ts",
    "license:generate": "npm -w @lingyi-doc/license run generate --",
    "license:generate:help": "npm -w @lingyi-doc/license run generate -- --help"
  },
  "dependencies": {
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@lingyi-doc/license": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-ws": "^10.4.22",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.22",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/ali-oss": "^6.23.3",
    "@types/bcryptjs": "^2.4.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0"
  }
}
