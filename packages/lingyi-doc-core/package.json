{
  "name": "@lingyi-doc/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types-reexport.js",
      "types": "./dist/types-reexport.d.ts"
    },
    "./model": {
      "import": "./dist/model-reexport.js",
      "types": "./dist/model-reexport.d.ts"
    },
    "./renderer": {
      "import": "./dist/renderer-reexport.js",
      "types": "./dist/renderer-reexport.d.ts"
    },
    "./formula": {
      "import": "./dist/formula-reexport.js",
      "types": "./dist/formula-reexport.d.ts"
    },
    "./collab": {
      "import": "./dist/collab-reexport.js",
      "types": "./dist/collab-reexport.d.ts"
    },
    "./client": {
      "import": "./dist/client-reexport.js",
      "types": "./dist/client-reexport.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lingyi-doc/core-types": "*",
    "@lingyi-doc/core-sheet": "*",
    "@lingyi-doc/core-doc": "*",
    "@lingyi-doc/core-mindmap": "*",
    "@lingyi-doc/core-whiteboard": "*",
    "@lingyi-doc/core-io": "*",
    "@lingyi-doc/core-collab": "*",
    "@lingyi-doc/core-client": "*"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
