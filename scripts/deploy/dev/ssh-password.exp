#!/usr/bin/expect -f
set timeout 600

if {![info exists env(DEPLOY_SSH_PASSWORD)] || $env(DEPLOY_SSH_PASSWORD) eq ""} {
  puts stderr "DEPLOY_SSH_PASSWORD 未设置"
  exit 1
}

set password $env(DEPLOY_SSH_PASSWORD)
set cmd $argv

# 关闭 expect 输出，避免污染 rsync 二进制协议
log_user 0
eval spawn $cmd

expect {
  -re {(?i)(password:|passphrase:)} {
    send -- "$password\r"
    exp_continue
  }
  eof
}

catch wait result
set exit_code [lindex $result 3]
if {$exit_code eq ""} { set exit_code 0 }
exit $exit_code
