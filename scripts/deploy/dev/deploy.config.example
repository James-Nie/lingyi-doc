# 本地部署配置 — 复制为 deploy.config.local 后修改
# cp scripts/deploy/dev/deploy.config.example scripts/deploy/dev/deploy.config.local

# ===== 阿里云 ECS SSH =====
DEPLOY_HOST=47.xxx.xxx.xxx
DEPLOY_USER=root
DEPLOY_SSH_PORT=22
# 可选，默认使用 ~/.ssh/id_rsa
# DEPLOY_SSH_KEY=~/.ssh/aliyun_ecs.pem
# 密码登录（开发环境），需本机安装 sshpass
# DEPLOY_SSH_PASSWORD='your_ecs_password'

# 服务器上的应用根目录
DEPLOY_PATH=/opt/lingyi-doc

# ===== 域名（无域名时可填 ECS 公网 IP）=====
# C 端与管理端共用同一域名/IP 时，管理端通过 /admin 路径访问
DESKTOP_DOMAIN=47.xxx.xxx.xxx
ADMIN_DOMAIN=47.xxx.xxx.xxx

# ===== HTTPS（证书放在 ECS /ssl/ 目录）=====
#   /ssl/cert.pem  — 服务器证书（或 fullchain）
#   /ssl/cert.key  — 私钥
#   /ssl/cert.cer  — 链证书/CA（可选，用于 ssl_trusted_certificate）
# 关闭 HTTPS: ENABLE_SSL=false

# ===== MySQL（dev 部署使用阿里云 RDS，不用 ECS Docker MySQL）=====
# 在 deploy/dev/.env 中配置 DB_HOST 为 RDS 地址（勿使用 127.0.0.1，除非 ECS 已安装本机 MySQL）

# ===== 部署行为 =====
# 本地构建并组装 deploy/dev/release 后 rsync（推荐）
BUILD_LOCALLY=true

# 数据库
# 首次部署：建库 + 基线表结构
RUN_INIT=false
# 每次部署：增量迁移（已有库时）
RUN_MIGRATE=true
# 首次部署可开启种子账号
RUN_SEED=true

# CREATE_DATABASE=true 与 RUN_INIT=true 等价（兼容旧配置）
CREATE_DATABASE=false

# 本地 MySQL / 首次 ECS 部署示例:
# RUN_INIT=true
# RUN_MIGRATE=true
# RUN_SEED=true
